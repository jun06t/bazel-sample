load("@bazel_gazelle//:def.bzl", "gazelle")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

# gazelle:prefix github.com/jun06t/bazel-sample/goembed
gazelle(name = "gazelle")

go_library(
    name = "goembed_lib",
    srcs = ["main.go"],
    embedsrcs = ["files/hello.txt"],
    importpath = "github.com/jun06t/bazel-sample/goembed",
    visibility = ["//visibility:private"],
)

go_binary(
    name = "goembed",
    embed = [":goembed_lib"],
    visibility = ["//visibility:public"],
)
